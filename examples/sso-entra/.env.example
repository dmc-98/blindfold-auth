# Blindfold workspace credentials — generate with: blindfold bootstrap
BLINDFOLD_WORKSPACE_ID=workspace_my_app
BLINDFOLD_SECRET=change-me-use-32-random-chars-min

# Microsoft Entra ID (Azure AD) app credentials
# From: Azure Portal → Microsoft Entra ID → App registrations → your app → Overview
ENTRA_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ENTRA_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# From: App registrations → your app → Certificates & secrets → Client secrets → Value
ENTRA_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your company's email domain for auto domain-routing (e.g. "contoso.com")
# Leave blank to use the tenant's default .onmicrosoft.com domain
ENTRA_DOMAIN=

# Application identifier (arbitrary, used to look up SSO bindings)
APP_ID=app_default

# Server port
PORT=3000
