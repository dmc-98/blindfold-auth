# Blindfold workspace credentials — generate with: blindfold bootstrap
BLINDFOLD_WORKSPACE_ID=workspace_my_app
BLINDFOLD_SECRET=change-me-use-32-random-chars-min

# Okta OIDC app credentials (from Okta admin → Applications → your app → General tab)
OKTA_CLIENT_ID=0oaXXXXXXXXXXXXXX
OKTA_CLIENT_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
OKTA_DOMAIN=https://dev-XXXXXX.okta.com

# Application identifier (arbitrary, used to look up SSO bindings)
APP_ID=app_default

# Server port
PORT=3000
