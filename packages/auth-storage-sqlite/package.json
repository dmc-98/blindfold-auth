{
  "name": "@dmc--98/blindfold-auth-storage-sqlite",
  "version": "0.1.1",
  "type": "module",
  "description": "SQLite storage adapter for Blindfold Auth using Node's built-in node:sqlite. Great for local development, tests, and edge/single-node deployments.",
  "main": "dist/src/index.js",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "test": "node --test dist/test/*.test.js",
    "build": "tsc -p .",
    "pretest": "npm run build"
  },
  "peerDependencies": {
    "@dmc--98/blindfold-auth": "0.1.1"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "types": "dist/src/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmc-98/blindfold-auth.git",
    "directory": "packages/auth-storage-sqlite"
  },
  "homepage": "https://github.com/dmc-98/blindfold-auth#readme",
  "bugs": {
    "url": "https://github.com/dmc-98/blindfold-auth/issues"
  },
  "files": [
    "dist",
    "!dist/test"
  ]
}
