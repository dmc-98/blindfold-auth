{
  "name": "@dmc--98/blindfold-playground",
  "version": "0.1.1",
  "type": "module",
  "description": "Interactive playground for Blindfold Auth: try login, RBAC/ABAC decisions with field masking, sessions, and copy-paste snippets in the browser.",
  "main": "dist/src/index.js",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./server": {
      "types": "./dist/src/server.d.ts",
      "default": "./dist/src/server.js"
    }
  },
  "scripts": {
    "test": "node --test dist/test/*.test.js",
    "build": "tsc -p .",
    "pretest": "npm run build"
  },
  "dependencies": {
    "@dmc--98/blindfold-auth": "0.1.1",
    "@dmc--98/blindfold-client": "0.1.1"
  },
  "types": "dist/src/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmc-98/blindfold-auth.git",
    "directory": "packages/auth-playground"
  },
  "homepage": "https://github.com/dmc-98/blindfold-auth#readme",
  "bugs": {
    "url": "https://github.com/dmc-98/blindfold-auth/issues"
  },
  "files": [
    "dist",
    "!dist/test"
  ]
}
