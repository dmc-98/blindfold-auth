{
  "name": "@dmc--98/blindfold-scim",
  "version": "1.0.0-rc.2",
  "type": "module",
  "description": "SCIM 2.0 user provisioning + compliance export for Blindfold Auth. Wraps the engine admin API as the standard /Users, /Groups, and /ServiceProviderConfig endpoints; emits NDJSON / JSON compliance exports of principals, memberships, and audit events.",
