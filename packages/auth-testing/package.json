{
  "name": "@dmc--98/blindfold-testing",
  "version": "0.1.1",
  "type": "module",
  "description": "Test helpers for Blindfold Auth: zero-dependency in-memory test mode, seed factories, session minting, and RBAC/ABAC assertions.",
  "main": "dist/src/index.js",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./conformance": {
      "types": "./dist/src/storage-conformance.d.ts",
      "default": "./dist/src/storage-conformance.js"
    }
  },
  "scripts": {
    "test": "node --test dist/test/*.test.js",
    "build": "tsc -p .",
    "pretest": "npm run build"
  },
  "dependencies": {
    "@dmc--98/blindfold-auth": "0.1.1",
    "@dmc--98/blindfold-client": "0.1.1"
  },
  "types": "dist/src/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmc-98/blindfold-auth.git",
    "directory": "packages/auth-testing"
  },
  "homepage": "https://github.com/dmc-98/blindfold-auth#readme",
  "bugs": {
    "url": "https://github.com/dmc-98/blindfold-auth/issues"
  },
  "files": [
    "dist",
    "!dist/test"
  ]
}
