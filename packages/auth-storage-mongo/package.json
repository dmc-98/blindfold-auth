{
  "name": "@dmc--98/blindfold-auth-storage-mongo",
  "version": "0.1.1",
  "type": "module",
  "description": "MongoDB (NoSQL) storage adapter for Blindfold Auth. Maps each auth table to a collection of documents.",
  "main": "dist/src/index.js",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./memory": {
      "types": "./dist/src/in-memory-db.d.ts",
      "default": "./dist/src/in-memory-db.js"
    }
  },
  "scripts": {
    "test": "node --test dist/test/*.test.js",
    "build": "tsc -p .",
    "pretest": "npm run build"
  },
  "peerDependencies": {
    "@dmc--98/blindfold-auth": "0.1.1",
    "mongodb": ">=5"
  },
  "peerDependenciesMeta": {
    "mongodb": {
      "optional": true
    }
  },
  "types": "dist/src/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmc-98/blindfold-auth.git",
    "directory": "packages/auth-storage-mongo"
  },
  "homepage": "https://github.com/dmc-98/blindfold-auth#readme",
  "bugs": {
    "url": "https://github.com/dmc-98/blindfold-auth/issues"
  },
  "files": [
    "dist",
    "!dist/test"
  ]
}
