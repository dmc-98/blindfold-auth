{
  "name": "@dmc--98/blindfold-client",
  "version": "0.1.0",
  "type": "module",
  "description": "Drop-in client SDK for Blindfold Auth: a few lines to add auth, RBAC/ABAC, and SSO to any app, with any SQL or NoSQL database.",
  "main": "dist/src/index.js",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./express": {
      "types": "./dist/src/express.d.ts",
      "default": "./dist/src/express.js"
    }
  },
  "scripts": {
    "test": "node --test dist/test/*.test.js",
    "build": "tsc -p .",
    "pretest": "npm run build"
  },
  "dependencies": {
    "@dmc--98/blindfold-auth": "0.1.0"
  },
  "peerDependencies": {
    "@dmc--98/blindfold-auth-storage-postgres": "0.1.0"
  },
  "peerDependenciesMeta": {
    "@dmc--98/blindfold-auth-storage-postgres": {
      "optional": true
    }
  },
  "types": "dist/src/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmc-98/blindfold-auth.git",
    "directory": "packages/auth-client"
  },
  "homepage": "https://github.com/dmc-98/blindfold-auth#readme",
  "bugs": {
    "url": "https://github.com/dmc-98/blindfold-auth/issues"
  }
}
