{
  "name": "@blindfold/client",
  "version": "0.1.0",
  "type": "module",
  "description": "Drop-in client SDK for Blindfold Auth: a few lines to add auth, RBAC/ABAC, and SSO to any app, with any SQL or NoSQL database.",
  "main": "dist/src/index.js",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./express": {
      "types": "./dist/src/express.d.ts",
      "default": "./dist/src/express.js"
    }
  },
  "scripts": {
    "test": "node --test dist/test/*.test.js",
    "build": "tsc -p .",
    "pretest": "npm run build"
  },
  "dependencies": {
    "@blindfold/auth": "0.1.0"
  },
  "peerDependencies": {
    "@blindfold/auth-storage-postgres": "0.1.0"
  },
  "peerDependenciesMeta": {
    "@blindfold/auth-storage-postgres": {
      "optional": true
    }
  },
  "types": "dist/src/index.d.ts"
}
